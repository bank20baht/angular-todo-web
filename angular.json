{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"version": 1,
	"cli": {
		"packageManager": "pnpm",
		"analytics": false
	},
	"newProjectRoot": "projects",
	"projects": {
		"IRCM": {
			"projectType": "application",
			"schematics": {},
			"root": "",
			"sourceRoot": "src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "@ngx-env/builder:application",
					"options": {
						"outputPath": "dist/todo-web",
						"index": "src/index.html",
						"browser": "src/main.ts",
						"polyfills": ["zone.js"],
						"tsConfig": "tsconfig.app.json",
						"assets": ["src/favicon.ico", "src/assets"],
						"styles": ["src/styles.css"],
						"scripts": [],
						"ngxEnv": {
							"prefix": "(NG_APP|MY)_"
						}
					},
					"configurations": {
						"production": {
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "5MB",
									"maximumError": "2MB"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "5MB",
									"maximumError": "1MB"
								}
							],
							"outputHashing": "all"
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "@ngx-env/builder:dev-server",
					"configurations": {
						"production": {
							"buildTarget": "IRCM:build:production"
						},
						"development": {
							"buildTarget": "IRCM:build:development"
						}
					},
					"defaultConfiguration": "development",
					"options": {}
				},
				"extract-i18n": {
					"builder": "@ngx-env/builder:extract-i18n",
					"options": {}
				},
				"test": {
					"builder": "@ngx-env/builder:karma",
					"options": {
						"polyfills": ["zone.js", "zone.js/testing"],
						"tsConfig": "tsconfig.spec.json",
						"assets": [
							{
								"glob": "**/*",
								"input": "public"
							}
						],
						"styles": ["src/styles.css"],
						"scripts": [],
						"builderMode": "browser"
					}
				}
			}
		}
	}
}
